{
  "name": "billwise-apk",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:web": "node -e \"require('fs').mkdirSync('www',{recursive:true}); require('fs').copyFileSync('billwise (2).html','www/index.html')\"",
    "test": "node --test tests/app.test.mjs",
    "update:all": "npm run android:sync",
    "android:add": "npx cap add android",
    "android:sync": "npm run build:web && npx cap sync android",
    "android:open": "npx cap open android",
    "android:release": "npx cap sync android && cd android && gradlew.bat assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/share": "^8.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0"
  }
}
